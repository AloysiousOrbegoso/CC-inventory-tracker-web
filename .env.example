APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailtrap is a sandbox — nothing sent here reaches a real inbox. Swap the
# five MAIL_* values below for one of the production options underneath
# when going live; no code change is needed, DiscrepancyAlertMail already
# queues (see app/Mail/DiscrepancyAlertMail.php) regardless of provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="alerts@inventory-tracker.test"
MAIL_FROM_NAME="Inventory Tracker Alerts"

# --- Production options (uncomment ONE block, fill in the values, remove the sandbox block above) ---
#
# Option A — Gmail SMTP (quick to start, low volume / free tier only):
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=            # a 16-char Google "App Password", not your login password
# MAIL_FROM_ADDRESS="you@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"
#
# Option B — SendGrid (SMTP relay, generous free tier, good deliverability):
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey      # literally the string "apikey", not your account name
# MAIL_PASSWORD=            # your SendGrid API key
# MAIL_FROM_ADDRESS="alerts@yourdomain.com"   # must be a verified sender in SendGrid
# MAIL_FROM_NAME="${APP_NAME}"
#
# Option C — Amazon SES (cheapest at scale, reuses the AWS_* credentials
# already below — the IAM user just needs ses:SendEmail + ses:SendRawEmail):
# MAIL_MAILER=ses
# MAIL_FROM_ADDRESS="alerts@yourdomain.com"   # must be a verified identity in SES
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=480

# Google Maps API key for the map page (get one at https://console.cloud.google.com/)
GOOGLE_MAPS_API_KEY=
